{
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i server/static_src/css/main.css -o server/static/css/main.css --minify",
    "build:js": "esbuild server/static_src/js/main.js --bundle --minify --format=iife --target=es2020 --outfile=server/static/js/main.js",
    "watch": "npm run watch:css & npm run watch:js & wait",
    "watch:css": "tailwindcss -i server/static_src/css/main.css -o server/static/css/main.css --watch=always",
    "watch:js": "esbuild server/static_src/js/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=server/static/js/main.js --watch=forever"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.47",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "lucide": "^1.53.0"
  }
}
